# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google OAuth download and one-time secret drops (never commit)
client_secret*.json
pg-password.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Candidate PII — resumes, interview recordings, and the local data store.
# These must never enter version control or a container image. Uploads now
# live under data/uploads (served only via the authenticated /api/media
# route) rather than public/uploads, which Next served to anyone with the URL.
/public/uploads/*
!/public/uploads/.gitkeep
/data/*.json
/data/uploads/*
!/data/uploads/.gitkeep

# Claude Code session-internal metadata — not project source
/.claude/scheduled_tasks.lock
